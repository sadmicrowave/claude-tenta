[Unit]
Description={{name}} Claude Code update (keeps the claude tool the worker runs current)
After=network-online.target
Wants=network-online.target

[Service]
User={{worker_user}}
Type=oneshot
TimeoutStartSec=15min
Environment=PYTHONPATH={{lib}}
Environment=CT_CONFIG={{config}}/ct.toml
{{sandbox}}
ExecStart=/usr/bin/python3 -m ct.cli claude-update
