[Unit]
Description=Check the {{name}} queue repo for new jobs

[Timer]
# systemd's default accuracy is a minute, which let a timer fire up to a minute late. (A comment must be on its own line: systemd has no inline comments and would ignore this setting.)
AccuracySec=1s
OnBootSec=60
OnUnitInactiveSec={{fetch_s}}

[Install]
WantedBy=timers.target
