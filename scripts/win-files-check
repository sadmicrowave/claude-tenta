#!/usr/bin/env python3
"""BY HAND, on a real Windows computer: write the worker's own files (src/armada/setup/winfiles.py) and run it twice (the second run must say changed=false). The layout, tools, release and mailbox must be there first
(scripts/win-layout-check, scripts/win-mailbox-check).
  scripts/win-files-check USER@HOST [--name NAME] [--worker-host ADDRESS]"""
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
from armada.setup import winfiles, wintools   # noqa: E402


def main(argv):
    if not argv or argv[0].startswith("-"):
        print(__doc__)
        return 2
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tests"))
    import preflight   # noqa: E402  (the machine must answer before anything is set up on it)
    preflight.require("real", argv[0])
    user, _, host = argv[0].rpartition("@")
    name = argv[argv.index("--name") + 1] if "--name" in argv else "armada"
    where = argv[argv.index("--worker-host") + 1] if "--worker-host" in argv else host
    run = wintools.ssh_runner(user, host)
    cfg, reg = winfiles.windows_config(name, where, user), winfiles.pack_text()
    bad = 0
    for label in ("ensure (first)", "ensure (second: must be unchanged)"):
        t0 = time.time()
        try:
            r = winfiles.ensure(run, cfg, reg)
        except wintools.WinToolsError as e:
            print(f"FAILED  {label}: {e.what}: {e.detail}")
            return 1
        print(f"{label:36} {r}  ({time.time() - t0:.0f} s)")
        bad += 1 if label.startswith("ensure (second") and r["changed"] else 0
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
