#!/usr/bin/env python3
"""Cut a release: bump the version, commit it, and tag it `release-X.Y.Z` (annotated, with the notes, signed if you ask).

    scripts/release 0.2.0                 check, bump, commit, tag; prints what to push; pushes nothing
    scripts/release 0.2.0 --sign          sign the tag with your SSH signing key (git config user.signingkey, gpg.format ssh)
    scripts/release 0.2.0 --notes FILE    use FILE as the release notes (default: the commit subjects since the last release)
    scripts/release 0.2.0 --skip-tests    skip the unit tests (the privacy check and a clean tree are always required)
    scripts/release 0.2.0 --dry-run       run every check and show what would be tagged, changing nothing
    scripts/release 0.1.0 --windows       the Windows line: tag `release-win-0.1.0` at this commit with docs/releases/win-0.1.0.md as its notes; no version bump, no commit

Everything that people or workers learn about a release comes from this tag: `arm-admin update` finds the newest `release-X.Y.Z`, shows its notes, and a worker
in `updates.mode = "signed-tags"` installs only a tag whose signature checks. Nothing is pushed here: you read the result, then push.
"""
import argparse
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VERSION_RE = re.compile(r"^\d+\.\d+\.\d+$")
FILES = (("pyproject.toml", re.compile(r'(?m)^version = "[^"]+"'), 'version = "{v}"'), ("src/armada/__init__.py", re.compile(r'(?m)^__version__ = "[^"]+"'), '__version__ = "{v}"'))


class ReleaseError(Exception):
    pass


def git(root, *args, check=True):
    r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    if check and r.returncode:
        raise ReleaseError(f"git {' '.join(args)}: {(r.stderr or r.stdout).strip()[-300:]}")
    return r.stdout.strip()


def prefix_for(windows):
    return "release-win-" if windows else "release-"                          # the Windows release is its own line of tags; the Linux check never sees it (updatecheck.TAG_RE_FOR)


def previous_tag(root, windows=False):
    pre = prefix_for(windows)
    tags = [t for t in git(root, "tag", "-l", pre + "*").split() if re.match("^" + re.escape(pre) + r"\d+\.\d+\.\d+$", t)]
    key = lambda t: tuple(int(x) for x in t[len(pre):].split("."))      # noqa: E731
    return max(tags, key=key, default=None)


def notes_since(root, prev):
    rng = f"{prev}..HEAD" if prev else "HEAD"
    subjects = git(root, "log", "--format=- %s", "--no-merges", rng)
    return subjects or "- (no changes recorded)"


def check(root, version, skip_tests=False, windows=False):
    if not VERSION_RE.match(version):
        raise ReleaseError("the version is three numbers, like 0.2.0")
    if git(root, "rev-parse", "--abbrev-ref", "HEAD") != "main":
        raise ReleaseError("releases are cut from main")
    if git(root, "status", "--porcelain"):
        raise ReleaseError("the working tree has uncommitted changes")
    pre = prefix_for(windows)
    if git(root, "tag", "-l", f"{pre}{version}"):
        raise ReleaseError(f"{pre}{version} already exists")
    prev = previous_tag(root, windows)
    if prev:
        old = tuple(int(x) for x in prev[len(pre):].split("."))
        if tuple(int(x) for x in version.split(".")) <= old:
            raise ReleaseError(f"{version} is not newer than {prev}")
    priv = Path(root) / "scripts" / "privacy-check"
    if priv.exists() and subprocess.run([str(priv), "--history"], cwd=root, capture_output=True, text=True).returncode:
        raise ReleaseError("the privacy check found something in the history: run scripts/privacy-check --history")
    if not skip_tests and (Path(root) / "tests").is_dir():
        pre = subprocess.run([sys.executable, str(Path(root) / "tests" / "preflight.py")], capture_output=True, text=True)
        if pre.returncode:
            raise ReleaseError("the tests cannot run here, so nothing was tagged:\n" + pre.stderr.strip())
        r = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests"], cwd=root, capture_output=True, text=True)
        if r.returncode:
            out = (r.stderr or "") + (r.stdout or "")
            log = Path(tempfile.gettempdir()) / "arm-release-tests.log"
            log.write_text(out)
            names = [ln for ln in out.splitlines() if ln.startswith(("FAIL:", "ERROR:"))]          # every failing test at once, so one run is enough to fix them all
            raise ReleaseError(f"{len(names)} unit test(s) fail (full output: {log}):\n" + "\n".join(names[:40]) + "\n" + "\n".join(out.splitlines()[-4:]))


def bump(root, version):
    for rel, rx, template in FILES:
        path = Path(root) / rel
        text = path.read_text()
        if not rx.search(text):
            raise ReleaseError(f"no version line in {rel}")
        path.write_text(rx.sub(template.format(v=version), text, count=1))


def windows_release(root, version, notes=None, sign=False, skip_tests=False):
    """The Windows line: the tag `release-win-X.Y.Z` at this commit, carrying docs/releases/win-X.Y.Z.md (CI refuses a tag whose message lacks it). No version bump and no commit: the Windows release has its own version."""
    check(root, version, skip_tests, windows=True)
    notes_file = Path(root) / "docs" / "releases" / f"win-{version}.md"
    if notes is None:
        if not notes_file.exists():
            raise ReleaseError(f"docs/releases/win-{version}.md is missing: write the Windows release notes first")
        notes = notes_file.read_text()
    tag, prev = f"release-win-{version}", previous_tag(root, True)
    git(root, "tag", "-s" if sign else "-a", "--cleanup=verbatim", tag, "-m", f"release win-{version}\n\n{notes}\n")
    if notes.strip() not in git(root, "tag", "-l", "--format=%(contents)", tag):
        git(root, "tag", "-d", tag)
        raise ReleaseError(f"the tag {tag} does not carry the release notes, so it was removed; nothing was pushed")
    return tag, prev


def release(root, version, notes=None, sign=False, skip_tests=False):
    check(root, version, skip_tests)
    prev = previous_tag(root)
    body = notes if notes is not None else notes_since(root, prev)
    bump(root, version)
    git(root, "add", "pyproject.toml", "src/armada/__init__.py")
    if git(root, "status", "--porcelain"):                   # the files may already say this version (the first release): then there is nothing to commit
        git(root, "commit", "-q", "-m", f"release {version}")
    message = f"release {version}\n\n{body}\n"
    git(root, "tag", "-s" if sign else "-a", "--cleanup=verbatim", f"release-{version}", "-m", message)          # verbatim: git would otherwise drop every line that starts with # (the notes' headings)
    said = git(root, "tag", "-l", "--format=%(contents)", f"release-{version}")
    if body.strip() and body.strip() not in said:                       # people read the notes from the tag: a tag that lost them (a later re-tag with a short message) is not a release
        git(root, "tag", "-d", f"release-{version}")
        raise ReleaseError(f"the tag release-{version} does not carry the release notes, so it was removed; nothing was pushed")
    return f"release-{version}", prev


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], add_help=True)
    ap.add_argument("version")
    ap.add_argument("--sign", action="store_true")
    ap.add_argument("--notes")
    ap.add_argument("--skip-tests", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--windows", action="store_true")
    a = ap.parse_args(argv)
    sys.path.insert(0, str(ROOT / "src"))
    from armada import ui                                        # the same card style as every other screen
    try:
        notes = Path(a.notes).read_text() if a.notes else None
        if a.dry_run:
            check(ROOT, a.version, a.skip_tests, a.windows)
            prev = previous_tag(ROOT, a.windows)
            wf = ROOT / "docs" / "releases" / f"win-{a.version}.md"
            if a.windows and notes is None and not wf.exists():
                raise ReleaseError(f"docs/releases/win-{a.version}.md is missing: write the Windows release notes first")
            body = notes if notes is not None else (wf.read_text() if a.windows else notes_since(ROOT, prev))
            ui.document(f"What {prefix_for(a.windows)}{a.version} would say", body, tag="DRY RUN", stream=sys.stdout)
            ui.say("Every check passed", ("Would tag", f"{prefix_for(a.windows)}{a.version}" + (" (signed)" if a.sign else "")), ("Previous release", prev or "none"),
                   ("Files at this version", ", ".join(rel for rel, rx, _ in FILES if f'"{a.version}"' in (ROOT / rel).read_text())),
                   "Nothing was changed.", tag="OK", color=ui.GREEN, stream=sys.stdout, run_label="To do it for real", run=f"scripts/release {a.version}" + (" --windows" if a.windows else "") + (f" --notes {a.notes}" if a.notes else ""))
            return 0
        tag, prev = (windows_release if a.windows else release)(ROOT, a.version, notes, a.sign, a.skip_tests)
    except ReleaseError as e:
        ui.say("The release was stopped", str(e), tag="ERROR", color=ui.RED)
        return 1
    ui.say(f"Created {tag}", ("The last one was", prev or "none"), "Nothing was pushed.", tag="DONE", color=ui.GREEN, stream=sys.stdout, run_label="To publish it",
           run=[f"git push origin {tag}"] if a.windows else ["git push origin main", f"git push origin {tag}"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
