#!/bin/bash
# Run tests/e2e/scenario.sh (or CT_E2E_SCENARIO=direct) in a DISPOSABLE OrbStack machine, show the result, and DELETE the machine afterwards.
#   scripts/e2e-orbstack            create a fresh machine, copy the current checkout in, run the scenario, save its logs, delete the machine
#   scripts/e2e-orbstack --keep     the same, but leave the machine running afterwards (to look around; delete it yourself: scripts/e2e-clean)
#   scripts/e2e-orbstack --delete   delete the machine and stop
# The machine is deleted even if the scenario fails or you press Ctrl-C: a test machine left running is a machine nobody remembers. What would be lost with it (the scenario's own
# output files and the services' journal) is copied first to /tmp/ct-e2e-logs/<machine>/. The machine only gets a copy of the tracked files (git archive), never your home folder.
# At most 4 test machines may exist at once; scripts/e2e-clean removes every one this project ever made.
set -euo pipefail
M=${CT_E2E_MACHINE:-ct-e2e}; IMAGE=${CT_E2E_IMAGE:-ubuntu:26.04}      # the release the supported servers run; CT_E2E_IMAGE=ubuntu:24.04 for the older one
KEEP=${CT_E2E_KEEP:-0}; [ "${1:-}" = "--keep" ] && KEEP=1
cd "$(dirname "$0")/.."
command -v orb >/dev/null || { echo "OrbStack's 'orb' command was not found." >&2; exit 2; }
gone() { orb delete -f "$M" >/dev/null 2>&1 || true; }
if [ "${1:-}" = "--delete" ]; then gone; exit 0; fi
orb list 2>/dev/null | awk '{print $1}' | grep -qx "$M" && gone                  # always a clean machine: an old one carries state from the last run
n=$(orb list 2>/dev/null | awk '{print $1}' | grep -cE '^(ct-e2e|ct-mx|ct-u|cw-e2e)' || true)
[ "$n" -ge 4 ] && { echo "There are already $n test machines. Run scripts/e2e-clean first." >&2; exit 3; }
LOGS=/tmp/ct-e2e-logs/$M
finish() {
  rc=$?
  if orb list 2>/dev/null | awk '{print $1}' | grep -qx "$M"; then
    mkdir -p "$LOGS"
    orb -m "$M" -u root bash -c 'journalctl --no-pager -o cat 2>/dev/null | tail -600 > /tmp/e2e-journal.out; tar -cf - /tmp/e2e-*.out 2>/dev/null' 2>/dev/null | tar -xf - -C "$LOGS" 2>/dev/null || true
    [ "$KEEP" = "1" ] && echo "Kept $M (delete it with: orb delete -f $M, or scripts/e2e-clean). Logs: $LOGS" >&2 || { gone; echo "Deleted $M. Logs: $LOGS" >&2; }
  fi
  exit $rc
}
trap finish EXIT INT TERM
orb create "$IMAGE" "$M"
git ls-files -z --cached --others --exclude-standard | COPYFILE_DISABLE=1 tar --null -T - -cf - | orb -m "$M" -u root bash -c 'rm -rf /opt/ct-src && mkdir -p /opt/ct-src && tar -xf - -C /opt/ct-src'
orb -m "$M" -u root bash /opt/ct-src/tests/e2e/${CT_E2E_SCENARIO:-scenario}.sh      # CT_E2E_SCENARIO=direct for the Direct connection
