#!/bin/bash
# Run ONE end-to-end route (tests/e2e/routes/<name>.sh; default install) from a BARE machine (the cold run: nothing pre-installed) in a DISPOSABLE OrbStack machine, show the result, and DELETE it.
# For all the routes at once, from a cached base machine, use scripts/e2e-routes.
#   scripts/e2e-orbstack            create a fresh machine, copy the current checkout in, run the scenario, save its logs, delete the machine
#   scripts/e2e-orbstack --keep     the same, but leave the machine running afterwards (to look around; delete it yourself: scripts/e2e-clean)
#   scripts/e2e-orbstack --delete   delete the machine and stop
# The machine is deleted even if the scenario fails or you press Ctrl-C: a test machine left running is a machine nobody remembers. What would be lost with it (the scenario's own
# output files and the services' journal) is copied first to /tmp/arm-e2e-logs/<run id>/<machine>/. The machine only gets a copy of the tracked files (git archive), never your home folder.
# At most 8 of this run id's machines (and 12 in all) may exist at once; scripts/e2e-clean removes this run id's.
set -euo pipefail
. "$(dirname "$0")/e2e-names.sh"; M=${ARM_E2E_MACHINE:-$(e2e_machine e2e)}; IMAGE=${ARM_E2E_IMAGE:-ubuntu:26.04}      # the release the supported servers run; ARM_E2E_IMAGE=ubuntu:24.04 for the older one
KEEP=${ARM_E2E_KEEP:-0}; [ "${1:-}" = "--keep" ] && KEEP=1
cd "$(dirname "$0")/.."
e2e_banner
"${ARM_PY:-$HOME/.arm-venv/bin/python}" tests/preflight.py --for e2e || exit 1                      # the environment is checked first: one message with the fix, not a long run that fails late
command -v orb >/dev/null || { echo "OrbStack's 'orb' command was not found." >&2; exit 2; }
gone() { orb delete -f "$M" >/dev/null 2>&1 || true; }
if [ "${1:-}" = "--delete" ]; then gone; exit 0; fi
orb list 2>/dev/null | awk '{print $1}' | grep -qx "$M" && gone                  # always a clean machine: an old one carries state from the last run
e2e_cap_check 8 || exit 3
LOGS=$(e2e_logs_dir "$M")
finish() {
  rc=$?
  if orb list 2>/dev/null | awk '{print $1}' | grep -qx "$M"; then
    mkdir -p "$LOGS"
    orb -m "$M" -u root bash -c 'journalctl --no-pager -o cat 2>/dev/null | tail -600 > /tmp/e2e-journal.out; tar -cf - /tmp/e2e-*.out 2>/dev/null' 2>/dev/null | tar -xf - -C "$LOGS" 2>/dev/null || true
    [ "$KEEP" = "1" ] && echo "Kept $M (delete it with: orb delete -f $M, or scripts/e2e-clean). Logs: $LOGS" >&2 || { gone; echo "Deleted $M. Logs: $LOGS" >&2; }
  fi
  exit $rc
}
trap finish EXIT INT TERM
orb create "$IMAGE" "$M"
git ls-files -z --cached --others --exclude-standard | COPYFILE_DISABLE=1 tar --null -T - -cf - | orb -m "$M" -u root bash -c 'rm -rf /opt/arm-src && mkdir -p /opt/arm-src && tar -xf - -C /opt/arm-src'
orb -m "$M" -u root bash /opt/arm-src/tests/e2e/${ARM_E2E_SCENARIO:-routes/install}.sh      # ARM_E2E_SCENARIO=routes/direct, routes/rename ... or smoke
