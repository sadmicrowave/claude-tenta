#!/bin/bash
# Run tests/e2e/scenario.sh in a DISPOSABLE OrbStack Ubuntu machine and show the result.
#   scripts/e2e-orbstack            create the machine if needed, copy the current checkout in, run the scenario (the machine is kept)
#   scripts/e2e-orbstack --fresh    delete the machine first, so everything starts from a clean Ubuntu
#   scripts/e2e-orbstack --delete   delete the machine and stop
# The machine only gets a copy of the tracked files (git archive), never your home folder's contents. Everything the scenario does happens inside it.
set -euo pipefail
M=${CT_E2E_MACHINE:-ct-e2e}; IMAGE=${CT_E2E_IMAGE:-ubuntu:26.04}      # the release the supported servers run; CT_E2E_IMAGE=ubuntu:24.04 for the older one
cd "$(dirname "$0")/.."
command -v orb >/dev/null || { echo "OrbStack's 'orb' command was not found." >&2; exit 2; }
if [ "${1:-}" = "--delete" ] || [ "${1:-}" = "--fresh" ]; then orb delete -f "$M" 2>/dev/null || true; [ "${1:-}" = "--delete" ] && exit 0; fi
orb list 2>/dev/null | awk '{print $1}' | grep -qx "$M" || orb create "$IMAGE" "$M"
git ls-files -z --cached --others --exclude-standard | COPYFILE_DISABLE=1 tar --null -T - -cf - | orb -m "$M" -u root bash -c 'rm -rf /opt/ct-src && mkdir -p /opt/ct-src && tar -xf - -C /opt/ct-src'
orb -m "$M" -u root bash /opt/ct-src/tests/e2e/${CT_E2E_SCENARIO:-scenario}.sh      # CT_E2E_SCENARIO=direct for the Direct connection (use another machine: CT_E2E_MACHINE=ct-e2e-direct)
