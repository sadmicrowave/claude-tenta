#!/usr/bin/env python3
"""Generate the reference pages that must never drift from the code: the configuration reference (from the schema) and the command reference
(from each command's own help). `scripts/gen-docs` writes them; `scripts/gen-docs --check` fails if the files on disk are out of date
(the unit tests run that check)."""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from cw import config  # noqa: E402
from cw.admin import cli as admin_cli  # noqa: E402
from cw.client import cli as client_cli  # noqa: E402
from cw.setup import questions  # noqa: E402

HEADER = "<!-- Generated by scripts/gen-docs from the code. Do not edit by hand: change the code, then run scripts/gen-docs. -->\n\n"


def show(v):
    if v is None:
        return "*(not set)*"
    if isinstance(v, bool):
        return "`true`" if v else "`false`"
    if isinstance(v, list):
        return "`" + str(v).replace("'", '"') + "`"
    return f"`{v}`"


def config_page():
    out = [HEADER, "# Configuration reference\n",
           "Every setting of `cw.toml`, with its default. The file is read from `~/.config/claude-ballast/cw.toml` on your computer and "
           "`/etc/<name>/cw.toml` on the server (or the path in `CW_CONFIG`). Any setting can also be set by an environment variable named "
           "`CW_<SECTION>_<KEY>` (lists are comma-separated), which wins over the file. Unknown sections and keys are errors, so a typo never "
           "silently falls back to a default. Secrets (API keys, alert tokens) never go in this file; they go in `secrets.env`.\n",
           "`{name}` and `{worker_user}` in a default are filled in from the settings of the same name.\n"]
    for section, fields in config.SCHEMA.items():
        out.append(f"\n## [{section}]\n\n| Setting | Default | Allowed | What it does |\n|---|---|---|---|")
        for key, (default, check, doc) in fields.items():
            opts = questions.options_of(f"{section}.{key}")
            kind = getattr(check, "kind", "")
            allowed = " , ".join(f"`{o}`" for o in opts) if opts else (kind or "text")
            out.append(f"| `{key}` | {show(default)} | {allowed} | {doc} |")
    return "\n".join(out) + "\n"


def commands_page():
    out = [HEADER, "# Command reference\n", "Each command also describes itself: `cw-run help`, `cw-admin help`, `cw-setup help`, and "
           "`<command> help <subcommand>` for the options of one.\n"]
    out.append("\n## cw-admin\n\nRun on your computer. Everything that changes the worker asks first and shows what it will do.\n")
    for title, names in admin_cli.GROUPS:
        out.append(f"\n### {title}\n\n| Command | What it does |\n|---|---|")
        for n in names:
            out.append(f"| `cw-admin {n}` | {admin_cli.HELP[n][0]} |")
    out.append("\n## cw-run\n\nRun on your computer. Sends work to the worker and reads the results.\n\n| Command | What it does |\n|---|---|")
    for n, (one, _ex) in client_cli.HELP.items():
        out.append(f"| `cw-run {n}` | {one} |")
    out.append("\n## cw-setup\n\n```\n" + (sys.modules["cw.setup.cli"].__doc__ if "cw.setup.cli" in sys.modules else __import__("cw.setup.cli", fromlist=["x"]).__doc__).strip() + "\n```\n")
    return "\n".join(out) + "\n"


PAGES = {"docs/reference/config.md": config_page, "docs/reference/commands.md": commands_page}


def main(argv):
    stale = []
    for rel, make in PAGES.items():
        text, path = make(), ROOT / rel
        if "--check" in argv:
            if not path.exists() or path.read_text() != text:
                stale.append(rel)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
            print(f"wrote {rel}")
    if stale:
        print("out of date (run scripts/gen-docs): " + ", ".join(stale), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
