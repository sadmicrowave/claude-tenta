#!/bin/bash
# Run every end-to-end route on every supported release, one release after the other (the routes of a release run side by side), and print one line per release.
#   scripts/e2e-matrix                 ubuntu:26.04 ubuntu:24.04 debian:bookworm debian:trixie
#   scripts/e2e-matrix debian:trixie   only the ones named
# Each release's machines are deleted when its routes end; the cached base machines stay (scripts/e2e-clean --all removes them). These machines share OrbStack's kernel, so the kernel-dependent
# checks (the tripwire, AppArmor) are not covered here: scripts/probe --on <real machine> ... does that. Exit status is the number of releases that failed.
set -uo pipefail
cd "$(dirname "$0")/.."
RELEASES=${*:-"ubuntu:26.04 ubuntu:24.04 debian:bookworm debian:trixie"}
bad=0
for image in $RELEASES; do
  echo "=== $image"
  if CT_E2E_IMAGE=$image scripts/e2e-routes; then :; else bad=$((bad+1)); fi
done
exit $bad
